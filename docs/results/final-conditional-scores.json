{
  "status": "measured_conditional_scores",
  "scope": "Trajectory and collision scores conditional on complete samples, from the per-case reports of jobs 46716 (D014) and 46837 (D015). The protocol's scene-level ADE/FDE stay undefined because no scene group has all its cases complete; these conditional values do not replace them.",
  "definitions": {
    "selected_mean_ade": "mean per-sample ADE of the selected object over samples whose selected track is complete, pooled over runs and cases, in normalized image units",
    "selected_best_of_4": "mean over (run, case) pairs with all four samples complete of the minimum per-sample ADE/FDE",
    "all_objects": "the same over samples with every object tracked",
    "collision_interval_prevalence": "reference contact prevalence over the scored pair intervals, (TP+FN)/scored, as the suite reports it",
    "collision_event_f1, collision_encounter_f1": "the suite's pooled collision scores; undefined when no complete pair timeline exists"
  },
  "caveat": "Complete samples are not a random subset: harder, faster or contact-heavy cases lose tracks more often. Conditional scores therefore favour methods that complete only easy cases and cannot rank methods with different completion.",
